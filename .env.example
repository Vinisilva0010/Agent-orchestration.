# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=agent_orchestration
POSTGRES_PASSWORD=
POSTGRES_DB=agent_orchestration
DATABASE_URL=postgres://agent_orchestration:<password>@127.0.0.1:5433/agent_orchestration

# Gateway. Generate the master key with:
#   python3 -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
GATEWAY_MASTER_KEY=
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
GATEWAY_ISSUER_SECRET=
GATEWAY_MONTHLY_BUDGET_USD=5
# Model provider: mock (no network), gemini or anthropic.
GATEWAY_PROVIDER=mock
# Optional Gemini model per tier. Must be in the gateway price catalog.
# GATEWAY_GEMINI_MODEL_SMALL=gemini-3.1-flash-lite
# GATEWAY_GEMINI_MODEL_STANDARD=gemini-3.8-flash
# GATEWAY_GEMINI_MODEL_LARGE=gemini-4-argon
